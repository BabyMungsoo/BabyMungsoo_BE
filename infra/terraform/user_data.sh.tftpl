#!/bin/bash
# EC2 최초 부팅 때 한 번만 실행된다. 로그: /var/log/emj-bootstrap.log
# 설치 → 파일 배치 → 첫 배포까지 여기서 끝낸다.
set -euo pipefail
exec > >(tee -a /var/log/emj-bootstrap.log) 2>&1

# t3.small(2GB)에서 Gradle 빌드 중 메모리가 모자라지 않도록 스왑 2GB
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

dnf install -y docker git
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/emj/data/postgres /opt/emj/data/uploads /opt/emj/caddy
cd /opt/emj

echo '${compose_b64}'   | base64 -d > docker-compose.yml
echo '${caddyfile_b64}' | base64 -d > caddy/Caddyfile
echo '${deploy_b64}'    | base64 -d > deploy.sh
chmod +x deploy.sh

(umask 077; echo '${env_b64}' | base64 -d > .env)

cat > deploy.conf <<'EOF'
GIT_REPO='${git_repo}'
GIT_REF='${git_ref}'
EOF

# 재부팅 때 공인 IP 가 바뀌어도 sslip.io 호스트명을 다시 맞추도록
cat > /etc/systemd/system/emj-host.service <<'EOF'
[Unit]
Description=Refresh API_HOST from public IP and restart caddy
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/emj/deploy.sh --host-only

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable emj-host.service

echo "=== 첫 배포 시작 ==="
./deploy.sh
echo "=== 부트스트랩 완료 ==="
